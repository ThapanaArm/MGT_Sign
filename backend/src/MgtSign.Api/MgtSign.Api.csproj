      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MgtSign.Domain\MgtSign.Domain.csproj" />
    <ProjectReference Include="..\MgtSign.Infrastructure\MgtSign.Infrastructure.csproj" />
  </ItemGroup>

</Project>
